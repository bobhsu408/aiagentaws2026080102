# ============================================
# 職涯導航家（CareerNav）環境變數範本
# 複製為 .env 後填入實際值
# ============================================

# --- AWS 基礎設定 ---
AWS_REGION=us-west-2
AWS_PROFILE=default

# --- Bedrock Model ---
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- AgentCore（agentcore deploy 後取得）---
AGENTCORE_AGENT_ID=
AGENTCORE_ALIAS_ID=

# --- Lambda Proxy ---
LAMBDA_FUNCTION_NAME=careernav-chat-proxy
LAMBDA_FUNCTION_URL=

# --- Exa AI MCP（即時搜尋，Task 5）---
# 留空即可運作（Exa 官方端點 keyless 可用，但有速率限制）。
# 填入後會以 URL query string 帶入 https://mcp.exa.ai/mcp（Exa 官方目前
# 唯一支援的金鑰傳遞方式，非 Authorization header），可提高額度上限。
EXA_API_KEY=

# --- LINE 通知（send_notification 未來擴充用，目前為 email 展示模式，可留空）---
# 取得方式：LINE Developers 後台建立 Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_DEMO_USER_ID=

# --- 前端（S3 部署用）---
FRONTEND_BUCKET_NAME=

# --- 開發/Debug ---
LOG_LEVEL=INFO
