# ============================================
# 職涯導航家（CareerNav）環境變數範本
# 複製為 .env 後填入實際值
# ============================================

# --- AWS 基礎設定 ---
AWS_REGION=us-west-2
AWS_PROFILE=default

# --- Bedrock Model ---
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- AgentCore（agentcore deploy 後取得）---
AGENTCORE_AGENT_ID=
AGENTCORE_ALIAS_ID=

# --- Lambda Proxy ---
LAMBDA_FUNCTION_NAME=careernav-chat-proxy
LAMBDA_FUNCTION_URL=

# --- Exa AI MCP（即時搜尋）---
EXA_API_KEY=

# --- 前端（S3 部署用）---
FRONTEND_BUCKET_NAME=

# --- 開發/Debug ---
LOG_LEVEL=INFO
